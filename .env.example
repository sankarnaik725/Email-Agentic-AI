# AI Mail Agent Configuration

# Gemini API Key (Get free from https://aistudio.google.com/)
GEMINI_API_KEY=

# IMAP Mail Server Configuration (Works with Gmail, Outlook, Yahoo, iCloud, etc.)
# For Gmail: Use 'imap.gmail.com', port 993, and generate an App Password:
# (Google Account -> Security -> 2-Step Verification -> App passwords)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_16_digit_app_password

# Set to true to use rich realistic sample emails for immediate demo/testing
DEMO_MODE=false
FETCH_COUNT=20
